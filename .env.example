# mainnet | testnet
NEXT_PUBLIC_XRPL_NETWORK=testnet

# Optional: override the WebSocket endpoint (comma-separated list = failover order)
# NEXT_PUBLIC_XRPL_WS=wss://xrplcluster.com,wss://s1.ripple.com

# Xaman (Xumm) developer console API key — https://apps.xaman.dev
# Add your site origin to the app's allowed origins / redirect URIs.
NEXT_PUBLIC_XAMAN_API_KEY=

# Pairs always shown on the Pools page, even without the indexer.
# Format: ASSET|ASSET, separated by commas. ASSET = XRP or CURRENCY.rIssuer
# NEXT_PUBLIC_FEATURED_PAIRS=XRP|RLUSD.rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De

# Postgres for the indexer (charts, trades, pool rankings). Leave empty to run without it.
DATABASE_URL=

# Indexer: endpoint to stream from (server-side, defaults to the network default)
# INDEXER_WS=wss://xrplcluster.com

# --- Swap fee (collected in XRP) ---
# Wallet that receives fees. Empty = no fee.
NEXT_PUBLIC_FEE_ACCOUNT=
# Basis points: 50 = 0.5% (max 500)
NEXT_PUBLIC_FEE_BPS=50
# batch = swap + fee in one atomic transaction (falls back to separate automatically)
# separate = swap, then a second fee payment | off
NEXT_PUBLIC_FEE_MODE=batch

# --- Branding / CBL integration ---
NEXT_PUBLIC_BRAND_NAME=CBL Swap
NEXT_PUBLIC_BRAND_LOGO=/brand/cbl.png
NEXT_PUBLIC_THEME=cbl
# Sites allowed to embed this app in an iframe
FRAME_ANCESTORS=https://cryptobarlounge.space https://*.cryptobarlounge.space https://cbl-crypto-hub.vercel.app
